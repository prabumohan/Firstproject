# Copy to .env in this folder, then: docker compose up --build
# Leave MAXMIND_LICENSE_KEY empty to start immediately (fallback mode).
# Never commit a real key.

HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
LOG_FORMAT=text

MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Inside the container; Compose binds this to the named volume.
MAXMIND_DATA_DIR=/data/maxmind
MAXMIND_EDITIONS=GeoLite2-City,GeoLite2-ASN
MAXMIND_UPDATE_INTERVAL_HOURS=24

# true = container is ready without an MMDB (demo IPs such as 8.8.8.8).
MAXMIND_ALLOW_FALLBACK=true
