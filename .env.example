# Copy to .env locally. Never commit real keys.
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
LOG_FORMAT=text

# Required to download GeoLite2/GeoIP2 from MaxMind.
# Sign up: https://www.maxmind.com/en/geolite2/signup
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Where MMDB files are stored (bind-mount / PVC in production).
MAXMIND_DATA_DIR=/data/maxmind
MAXMIND_EDITIONS=GeoLite2-City,GeoLite2-ASN
MAXMIND_UPDATE_INTERVAL_HOURS=24

# true: /ready succeeds with the tiny built-in demo dataset if no MMDB is present.
# false: /ready returns 503 until a City or ASN database is loaded.
MAXMIND_ALLOW_FALLBACK=true

# Optional explicit paths; otherwise files are discovered in MAXMIND_DATA_DIR.
# GEOIP_CITY_DB_PATH=/data/maxmind/GeoLite2-City.mmdb
# GEOIP_ASN_DB_PATH=/data/maxmind/GeoLite2-ASN.mmdb
